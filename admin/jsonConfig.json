{
  "i18n": true,
  "type": "panel",
  "items": {
    "clientId": {
      "type": "text",
      "label": "Lufthansa Client ID (Application Key)"
    },
    "clientSecret": {
      "type": "password",
      "label": "Lufthansa Client Secret"
    },
    "flightNumberState": {
      "type": "text",
      "label": "ioBroker-Objekt mit Flugnummer",
      "default": "openairlog.0.today.currentFlightNumber"
    },
    "flightDateState": {
      "type": "text",
      "label": "Optional: ioBroker-Objekt mit Abflugdatum (YYYY-MM-DD)"
    },
    "pollIntervalSec": {
      "type": "number",
      "label": "Abfrageintervall (Sekunden)",
      "min": 60,
      "max": 3600,
      "default": 300
    },
    "inFlightPollIntervalSec": {
      "type": "number",
      "label": "Intervall in der Luft nach erster ETA (Sekunden)",
      "min": 600,
      "max": 900,
      "default": 600
    },
    "terminalRetentionMinutes": {
      "type": "number",
      "label": "Anzeigezeit nach Landung oder Annullierung (Minuten)",
      "min": 0,
      "max": 1440,
      "default": 30
    },
    "nextFlightNumberState": {
      "type": "text",
      "label": "ioBroker-Objekt mit nächster Flugnummer",
      "default": "openairlog.0.next.flightNumber"
    },
    "nextFlightDateState": {
      "type": "text",
      "label": "ioBroker-Objekt mit nächstem Abflugdatum (YYYY-MM-DD)",
      "default": "openairlog.0.next.date"
    },
    "nextScheduledOffBlockState": {
      "type": "text",
      "label": "ioBroker-Objekt mit geplantem Offblock des nächsten Flugs",
      "default": "openairlog.0.next.scheduledOffBlock"
    },
    "preflightDisplayMinutes": {
      "type": "number",
      "label": "Anzeigezeit vor Abflug (Minuten)",
      "min": 0,
      "max": 240,
      "default": 30
    },
    "preflightPollIntervalSec": {
      "type": "number",
      "label": "Vorflug-Abfrageintervall (Sekunden)",
      "min": 300,
      "max": 3600,
      "default": 900
    }
  }
}
