{
  "common": {
    "name": "lufthansa-flightstatus",
    "version": "0.3.9",
    "news": {},
    "titleLang": {
      "en": "Lufthansa Flight Status",
      "de": "Lufthansa Flugstatus"
    },
    "desc": {
      "en": "Retrieves a flight status using Lufthansa Open API.",
      "de": "Ruft einen Flugstatus über die Lufthansa Open API ab."
    },
    "authors": ["Stefan"],
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "compact": true,
    "enabled": true,
    "icon": "lufthansa-flightstatus.svg",
    "extIcon": "https://raw.githubusercontent.com/harryslapalot/ioBroker.lufthansa-flightstatus/main/admin/lufthansa-flightstatus.svg",
    "readme": "https://developer.lufthansa.com/docs/read/api_details/operations/Flight_Status",
    "loglevel": "info",
    "tier": 3,
    "type": "travel",
    "connectionType": "cloud",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    },
    "globalDependencies": [{"admin": ">=7.6.0"}],
    "dependencies": [{"js-controller": ">=5.0.0"}]
  },
  "native": {
    "clientId": "",
    "clientSecret": "",
    "flightNumberState": "openairlog.0.today.currentFlightNumber",
    "flightDateState": "",
    "pollIntervalSec": 300,
    "inFlightPollIntervalSec": 600,
    "terminalRetentionMinutes": 30,
    "nextFlightNumberState": "openairlog.0.next.flightNumber",
    "nextFlightDateState": "openairlog.0.next.date",
    "nextScheduledOffBlockState": "openairlog.0.next.scheduledOffBlock",
    "preflightDisplayMinutes": 30,
    "preflightPollIntervalSec": 900,
    "apiBase": "https://api.lufthansa.com/v1"
  },
  "objects": [],
  "protectedNative": [],
  "encryptedNative": ["clientSecret"]
}
